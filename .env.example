# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN "VŨ VĂN HÀ CÔNG - HÀNH TRÌNH 100 NGÀY HỌC TIẾNG ANH"
# Cấu hình trên Vercel: Project Settings -> Environment Variables
# ==============================================================================

# 1. URL của website khi triển khai (Production / Custom Domain)
# Khi deploy Vercel, nếu không đặt biến này hệ thống sẽ tự động dùng domain từ VERCEL_PROJECT_PRODUCTION_URL
SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 1.1 Mã xác minh Google Search Console (HTML Tag verification)
# Lấy chuỗi content trong <meta name="google-site-verification" content="..." />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_token_here

# 2. Mật khẩu quản trị khu vực /admin (BẢO MẬT PHÍA SERVER)
# Tuyệt đối không dùng prefix NEXT_PUBLIC_ hoặc VITE_ để tránh lộ ra phía client bundle.
ADMIN_PASSWORD=your_secure_admin_password_here

# 3. Chuỗi bí mật ký HMAC-SHA256 session cho Admin (ít nhất 32 ký tự ngẫu nhiên)
# Dùng để mã hóa và xác thực chữ ký số của HttpOnly Cookie vvhc_admin_session
SESSION_SECRET=your_random_secret_hash_key_min_32_chars_random_string

# 4. Cấu hình GitHub-backed CMS (Git-as-CMS)
# Cho phép Admin xuất bản bài học trực tiếp từ giao diện Admin lên GitHub repo.
# Mỗi khi bài học được lưu lên GitHub, GitHub sẽ tự động kích hoạt Vercel redeploy
# giúp bài học xuất hiện đồng bộ trên mọi thiết bị mà không cần cơ sở dữ liệu đắt tiền.
#
# Tạo GitHub Personal Access Token (Fine-grained hoặc Classic):
# - Quyền (Permissions): Contents: Read and write
# - Cấu hình token tại Vercel Environment Variables:
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=congkcks/pixel-perfect-replica
GITHUB_BRANCH=main
